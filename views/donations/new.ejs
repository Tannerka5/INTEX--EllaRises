<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card">
    <h1 class="register-title">Add Donation</h1>
    <p class="register-subtitle">Record a new donation from a participant.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/donations" method="POST" class="register-form">
      <div class="register-field">
        <label>Participant</label>
        <select name="participantid" required>
          <option value="">Select participant...</option>
          <% participants.forEach(p => { %>
            <option value="<%= p.participantid %>">
              <%= p.participantlastname %>, <%= p.participantfirstname %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="register-field">
        <label>Donation Date</label>
        <input type="date" name="donationdate" required />
      </div>

      <div class="register-field">
        <label>Amount</label>
        <input type="number" step="0.01" min="0" name="donationamount" required />
      </div>

      <button type="submit" class="btn-pill btn-primary register-btn">
        Save Donation
      </button>
    </form>

    <p class="register-bottom">
      <a href="/donations" class="register-link">Back to Donations</a>
    </p>
  </div>
</main>

<%- include("../partials/footer") %>
