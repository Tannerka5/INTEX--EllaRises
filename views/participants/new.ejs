<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="bg-gradient-hero min-h-screen py-12 page-main">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Back button -->
    <a href="/participants" class="flex items-center gap-2 text-muted-foreground hover:text-foreground mb-6">
      ← Back to Participants
    </a>

    <div class="card-pastel">
      <h1 class="text-3xl font-bold text-foreground mb-6">Add New Participant</h1>

      <form action="/participants/new" method="POST" class="space-y-6">

        <div class="grid md:grid-cols-2 gap-6">

          <!-- Name -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Full Name *</label>
            <input name="name" type="text" required class="input-pastel" />
          </div>

          <!-- Email -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Email *</label>
            <input name="email" type="email" required class="input-pastel" />
          </div>

          <!-- Phone -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Phone</label>
            <input name="phone" type="tel" class="input-pastel" />
          </div>

          <!-- Program -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Program *</label>
            <select name="program" required class="input-pastel">
              <option value="">Select program</option>
              <option value="STEAM">STEAM Education</option>
              <option value="Arts">Arts & Culture</option>
              <option value="Ballet">Ballet & Dance</option>
              <option value="Mentorship">Mentorship</option>
            </select>
          </div>

          <!-- Status -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Status</label>
            <select name="status" class="input-pastel">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>

        </div>

        <!-- Notes -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-2">Notes</label>
          <textarea name="notes" class="input-pastel min-h-32" placeholder="Additional notes..."></textarea>
        </div>

        <div class="flex gap-4">
          <button type="submit" class="btn-pill btn-primary">Add Participant</button>

          <a href="/participants" class="btn-pill bg-white border-2 border-border hover:border-primary">
            Cancel
          </a>
        </div>

      </form>
    </div>

  </div>
</main>

<%- include("../partials/footer") %>