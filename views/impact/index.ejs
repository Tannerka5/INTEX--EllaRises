<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="dashboard-main bg-gradient-hero">
  <div class="dashboard-container">



    <!-- Header -->
    <header style="margin-bottom:2rem; display:flex; flex-direction:column; align-items:center;">

      <div 
        style="
          width:100%;
          display:flex;
          align-items:center;
          justify-content:center;
          gap:1.5rem;
          margin-bottom:1rem;
        "
      >
        <!-- Left flower -->
        <img 
          src="/images/flower-left.avif" 
          alt="Decorative Flower" 
          style="max-width:140px; width:100%; opacity:0.9;"
        />

        <!-- Title -->
        <h1 class="page-title" style="white-space:nowrap; text-align:center;">
          Ella Rises Community Impact
        </h1>

        <!-- Right flower -->
        <img 
          src="/images/flower-right.avif" 
          alt="Decorative Flower" 
          style="max-width:140px; width:100%; opacity:0.9;"
        />
      </div>

      <p class="text-muted-foreground" style="max-width:700px; text-align:center;">
        Transforming lives and building brighter futures through education,
        culture, mentorship, and community.
      </p>
    </header>


    <!-- Tableau Embed -->
    <section class="card-pastel" style="padding:1.5rem;">
      <div class='tableauPlaceholder' id='vizImpactDashboard' style='position: relative'>
        <noscript>
          <a href='#'>
            <img 
              alt='Impact KPIs #1 & #2'
              src='https://public.tableau.com/static/images/Ne/New-Intex1-14-2025/ImpactKPIs12/1_rss.png'
              style='border:none'
            />
          </a>
        </noscript>

        <object class='tableauViz' style='display:none;'>
          <param name='host_url' value='https%3A%2F%2Fpublic.tableau.com%2F' />
          <param name='embed_code_version' value='3' />
          <param name='site_root' value='' />
          <param name='name' value='New-Intex1-14-2025/ImpactKPIs12' />
          <param name='tabs' value='no' />
          <param name='toolbar' value='yes' />
          <param name='static_image' value='https://public.tableau.com/static/images/Ne/New-Intex1-14-2025/ImpactKPIs12/1.png' />
          <param name='animate_transition' value='yes' />
          <param name='display_static_image' value='yes' />
          <param name='display_spinner' value='yes' />
          <param name='display_overlay' value='yes' />
          <param name='display_count' value='yes' />
          <param name='language' value='en-US' />
        </object>
      </div>
    </section>


    <!-- IMPACT IMAGES GALLERY -->
    <section style="margin-top:3rem;">
      <h2 class="page-title" style="text-align:center; margin-bottom:1rem;">
        Our Community In Action
      </h2>

      <div 
        style="
          display:grid; 
          grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); 
          gap:1.5rem;
        "
      >
        <img src="/images/impact1.avif" alt="Impact 1" style="width:100%; border-radius:12px;">
        <img src="/images/impact2.avif" alt="Impact 2" style="width:100%; border-radius:12px;">
        <img src="/images/impact3.avif" alt="Impact 3" style="width:100%; border-radius:12px;">
        <img src="/images/impact4.avif" alt="Impact 4" style="width:100%; border-radius:12px;">
      </div>
    </section>

  </div>
</main>

<%- include("../partials/footer") %>

<script type='text/javascript'>
  (function () {
    var divElement = document.getElementById('vizImpactDashboard');
    if (!divElement) return;

    var vizElement = divElement.getElementsByTagName('object')[0];

    if (divElement.offsetWidth > 800) {
      vizElement.style.width = '100%';
      vizElement.style.height = '827px';
    } else if (divElement.offsetWidth > 500) {
      vizElement.style.width = '100%';
      vizElement.style.height = '827px';
    } else {
      vizElement.style.width = '100%';
      vizElement.style.height = '1677px';
    }

    var scriptElement = document.createElement('script');
    scriptElement.src = 'https://public.tableau.com/javascripts/api/viz_v1.js';
    vizElement.parentNode.insertBefore(scriptElement, vizElement);
  })();
</script>

