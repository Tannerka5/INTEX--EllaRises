<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="bg-gradient-hero min-h-screen py-12 dashboard-main dashboard-container">

  <!-- Welcome -->
  <div class="mb-10">
    <h1 class="text-4xl font-bold text-foreground mb-2">Welcome, <%= currentUser.full_name %>!</h1>
    <p class="text-muted-foreground">Manager Dashboard Overview</p>
  </div>

  <!-- TOP SUMMARY STATS -->
  <div class="dashboard-grid">
    
    <!-- Participants Count -->
    <div class="dashboard-card text-center">
      <h2 class="text-xl font-semibold mb-2">👥 Participants</h2>
      <div class="text-4xl font-bold text-primary mb-2"><%= stats.participants %></div>
      <p class="text-muted-foreground">Total Registered Participants</p>
      <a href="/participants" class="dashboard-section-link mt-3 inline-block">Manage participants →</a>
    </div>

    <!-- Events Count -->
    <div class="dashboard-card text-center">
      <h2 class="text-xl font-semibold mb-2">📅 Events</h2>
      <div class="text-4xl font-bold text-secondary mb-2"><%= stats.events %></div>
      <p class="text-muted-foreground">Total Events Scheduled</p>
      <a href="/events" class="dashboard-section-link mt-3 inline-block">Manage events →</a>
    </div>

    <!-- Surveys Count -->
    <div class="dashboard-card text-center">
      <h2 class="text-xl font-semibold mb-2">📝 Surveys</h2>
      <div class="text-4xl font-bold text-accent mb-2"><%= stats.surveys %></div>
      <p class="text-muted-foreground">Completed Post-Event Surveys</p>
      <a href="/surveys/results" class="dashboard-section-link mt-3 inline-block">View results →</a>
    </div>

  </div>

  <!-- MANAGER CONTROL CARDS -->
  <div class="dashboard-grid mt-12">

    <!-- Participants Preview -->
    <div class="dashboard-card">
      <h2 class="text-xl font-bold mb-4">👥 Recent Participants</h2>
      <% recentParticipants.forEach(p => { %>
        <p class="mb-2">
          <strong><%= p.participantfirstname %> <%= p.participantlastname %></strong>
          <br><span class="text-muted-foreground text-sm"><%= p.participantschooloremployer || "" %></span>
        </p>
      <% }) %>
      <a href="/participants" class="dashboard-section-link">Manage all participants →</a>
    </div>

    <!-- Upcoming Events Preview -->
    <div class="dashboard-card">
      <h2 class="text-xl font-bold mb-4">📅 Upcoming Events</h2>
      <% upcomingEvents.forEach(e => { %>
        <p class="mb-2">
          <strong><%= e.eventname %></strong><br>
          <span class="text-muted-foreground text-sm"><%= new Date(e.eventdatetimestart).toLocaleString() %></span>
        </p>
      <% }) %>
      <a href="/events" class="dashboard-section-link">Manage all events →</a>
    </div>

    <!-- Recent Surveys -->
    <div class="dashboard-card">
      <h2 class="text-xl font-bold mb-4">📝 Recent Surveys</h2>
      <% recentSurveys.forEach(s => { %>
        <p class="mb-2">
          <strong><%= s.eventname %></strong><br>
          <span class="text-muted-foreground text-sm">By <%= s.participantfirstname %> <%= s.participantlastname %></span>
        </p>
      <% }) %>
      <a href="/surveys/results" class="dashboard-section-link">View survey results →</a>
    </div>

  </div>

  <!-- ANALYTICS CARDS -->
  <div class="dashboard-grid mt-12">

    <!-- Milestones -->
    <div class="dashboard-card">
      <h2 class="text-xl font-bold mb-4">🏅 Top Milestone Earners</h2>
      <% milestoneLeaders.forEach(m => { %>
        <p class="mb-2">
          <strong><%= m.participantfirstname %> <%= m.participantlastname %></strong><br>
          <span class="text-muted-foreground text-sm"><%= m.total %> milestones</span>
        </p>
      <% }) %>
      <a href="/milestones/manage" class="dashboard-section-link">Open milestone manager →</a>
    </div>

    <!-- Donations -->
    <div class="dashboard-card">
      <h2 class="text-xl font-bold mb-4">💖 Recent Donations</h2>
      <% donations.forEach(d => { %>
        <p class="mb-2">
          <strong>$<%= d.donationamount %></strong><br>
          <span class="text-muted-foreground text-sm">By <%= d.donorname %></span>
        </p>
      <% }) %>
      <a href="/donations" class="dashboard-section-link">Manage donations →</a>
    </div>

  </div>

</main>

<%- include("../partials/footer") %>
