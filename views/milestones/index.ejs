<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card" style="max-width: 900px; width:100%;">
    <h1 class="register-title">Milestones</h1>
    <p class="register-subtitle">
      <% if (currentUser && currentUser.role === 'Manager') { %>
        Track participant milestones over time.
      <% } else { %>
        Milestones you have earned with Ella Rises.
      <% } %>
    </p>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <!-- Search + Add button -->
    <div style="display:flex; justify-content:space-between; gap:1rem; margin-bottom:1rem; align-items:flex-end;">
      <div class="register-field" style="flex:1; margin-bottom:0; position:relative;">
        <label>Search milestones</label>
        <input
          type="text"
          id="milestoneSearch"
          placeholder="Search by title<% if (currentUser && currentUser.role === 'Manager') { %>, participant<% } %>, or date…"
          style="padding-right:2rem;"
        />
        <button
          type="button"
          id="clearMilestoneSearch"
          aria-label="Clear search"
          style="
            position:absolute;
            right:0.5rem;
            top:50%;
            transform:translateY(10%);
            border:none;
            background:transparent;
            font-size:1.1rem;
            line-height:1;
            cursor:pointer;
            color:#9CA3AF;
            transition:color 0.15s ease, transform 0.15s ease;
          "
          onmouseover="this.style.color='#ff8a80'; this.style.transform='translateY(10%) scale(1.25)';"
          onmouseout="this.style.color='#9CA3AF'; this.style.transform='translateY(10%) scale(1)';"
        >
          &times;
        </button>
      </div>

      <% if (currentUser && currentUser.role === 'Manager') { %>
        <a href="/milestones/new" class="btn-pill btn-primary register-btn" style="width:auto; white-space:nowrap;">
          + Add Milestone
        </a>
      <% } %>
    </div>

    <!-- Milestones table -->
    <div style="overflow-x:auto;">
      <table class="table table-striped" id="milestonesTable" style="width:100%; border-collapse:collapse;">
        <thead>
          <tr>
            <th style="text-align:left; padding:0.6rem;">Milestone Title</th>
            <% if (currentUser && currentUser.role === 'Manager') { %>
              <th style="text-align:left; padding:0.6rem;">Participant</th>
            <% } %>
            <th style="text-align:left; padding:0.6rem;">Milestone Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (!milestones || milestones.length === 0) { %>
            <tr>
              <td colspan="<%= currentUser && currentUser.role === 'Manager' ? '3' : '2' %>" style="padding:1rem; text-align:center; color:#9CA3AF;">
                <% if (currentUser && currentUser.role === 'Manager') { %>
                  No milestones have been added yet.
                <% } else { %>
                  No milestones earned yet. Keep going—you're just getting started!
                <% } %>
              </td>
            </tr>
          <% } else { %>
            <% milestones.forEach(m => { %>
              <tr>
                <td style="padding:0.6rem;">
                  <a
                    href="/milestones/<%= m.milestoneid %>"
                    class="register-link"
                    style="color:#ffc2b5; transition:color 0.15s ease, transform 0.15s ease; display:inline-block;"
                    onmouseover="this.style.transform='translateY(-1px)';"
                    onmouseout="this.style.transform='translateY(0)';"
                  >
                    <%= m.milestonetitle %>
                  </a>
                </td>
                <% if (currentUser && currentUser.role === 'Manager') { %>
                  <td style="padding:0.6rem;">
                    <%= m.participantfirstname %> <%= m.participantlastname %>
                  </td>
                <% } %>
                <td style="padding:0.6rem;">
                  <% if (m.milestonedate) { %>
                    <%= m.milestonedate.toISOString().slice(0,10) %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <p class="register-bottom" style="margin-top:1.2rem;">
      Total milestones: <strong><%= milestones.length %></strong>
    </p>
  </div>
</main>

<script>
  (function () {
    const input = document.getElementById('milestoneSearch');
    const clearBtn = document.getElementById('clearMilestoneSearch');
    const table = document.getElementById('milestonesTable');
    if (!input || !table) return;

    function filterRows() {
      const query = input.value.toLowerCase();
      const rows = table.querySelectorAll('tbody tr');
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
      });
    }

    input.addEventListener('input', filterRows);
    clearBtn.addEventListener('click', function () {
      input.value = '';
      filterRows();
      input.focus();
    });
  })();
</script>

<%- include("../partials/footer") %>
