<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">

  <div class="register-card">

    <h1 class="register-title">Create Account</h1>
    <p class="register-subtitle">Join our community!</p>

    <form action="/register" method="POST" class="register-form">

      <!-- Full Name -->
      <div class="register-field">
        <label>Full Name</label>
        <input
          type="text"
          name="name"
          placeholder="Jane Doe"
          required
        />
      </div>

      <!-- Email -->
      <div class="register-field">
        <label>Email Address</label>
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          required
        />
      </div>

      <!-- Password -->
      <div class="register-field">
        <label>Password</label>
        <input
          type="password"
          name="password"
          placeholder="••••••••"
          required
        />
      </div>

      <!-- Confirm Password -->
      <div class="register-field">
        <label>Confirm Password</label>
        <input
          type="password"
          name="confirmPassword"
          placeholder="••••••••"
          required
        />
      </div>

      <!-- Button -->
      <button type="submit" class="btn-pill btn-primary register-btn">
        Create Account
      </button>

    </form>

    <p class="register-bottom">
      Already have an account?
      <a href="/login" class="register-link">Sign in</a>
    </p>

  </div>

</main>

<%- include("../partials/footer") %>