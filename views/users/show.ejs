<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card" style="max-width: 720px; width:100%; position:relative;">

    <!-- Back button (top-left) -->
    <a
      href="/users"
      class="btn-pill btn-secondary"
      style="
        position:absolute;
        top:1.6rem;
        left:1.6rem;
        padding-inline:1.4rem;
        font-size:0.9rem;
      "
    >
      ← Go Back
    </a>

    <% if (currentUser && currentUser.role === 'Manager') { %>
      <button
        type="button"
        id="editToggle"
        class="btn-pill btn-secondary"
        style="position:absolute; top:1.6rem; right:1.6rem; padding-inline:1.4rem; font-size:0.9rem;"
      >
        Edit
      </button>
    <% } %>

    <div style="text-align:center;">
      <h1 class="register-title">
        <%= user.full_name %>
      </h1>
      <p class="register-subtitle">User account details</p>
    </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form
      id="userForm"
      action="/users/<%= user.id %>?_method=PUT"
      method="POST"
      class="register-form"
      style="margin-top:1.4rem;"
    >
      <div class="register-field">
        <label>Full Name</label>
        <input
          type="text"
          name="full_name"
          value="<%= user.full_name %>"
          disabled
        />
      </div>

      <div class="register-field">
        <label>Email</label>
        <input
          type="email"
          name="email"
          value="<%= user.email %>"
          disabled
        />
      </div>

      <div class="register-field">
        <label>Role</label>
        <div style="display:flex; align-items:center; gap:1rem;">
          <span id="roleDisplay" style="font-weight:600; color:#6B7280;">
            <%= user.role %>
          </span>
          <button
            type="button"
            id="roleToggle"
            class="btn-pill btn-secondary"
            style="padding:0.4rem 1rem; font-size:0.85rem; display:none;"
          >
            Switch to <%= user.role === 'Manager' ? 'User' : 'Manager' %>
          </button>
        </div>
        <input type="hidden" name="role" id="roleInput" value="<%= user.role %>" />
      </div>

      <% if (user.participantid) { %>
        <div class="register-field">
          <label>Linked Participant ID</label>
          <input
            type="text"
            value="<%= user.participantid %>"
            disabled
            style="background:#f9fafb; color:#6B7280;"
          />
        </div>
      <% } %>

      <% if (currentUser && currentUser.role === 'Manager') { %>
        <div id="editButtons" style="display:none; margin-top:1.4rem; gap:0.8rem; flex-wrap:wrap;">
          <button
            type="submit"
            class="btn-pill btn-primary"
            style="background-color:#ffc2b5; border:none;"
          >
            Save Changes
          </button>
          <button type="button" id="cancelEdit" class="btn-pill btn-secondary">
            Cancel
          </button>
        </div>
      <% } %>
    </form>

    <% if (currentUser && currentUser.role === 'Manager') { %>
      <form
        id="deleteForm"
        action="/users/<%= user.id %>?_method=DELETE"
        method="POST"
        style="margin-top:1.8rem; text-align:right;"
        onsubmit="return confirmDelete();"
      >
        <button
          type="submit"
          class="btn-pill"
          style="background-color:#dc2626; color:white; border:none;"
        >
          Delete User
        </button>
      </form>
    <% } %>
  </div>
</main>

<script>
  (function () {
    const editBtn = document.getElementById('editToggle');
    const form = document.getElementById('userForm');
    const editButtons = document.getElementById('editButtons');
    const cancelBtn = document.getElementById('cancelEdit');
    if (!editBtn || !form || !editButtons || !cancelBtn) return;

    const fullNameInput = form.querySelector('input[name="full_name"]');
    const emailInput = form.querySelector('input[name="email"]');
    const roleInput = document.getElementById('roleInput');
    const roleDisplay = document.getElementById('roleDisplay');
    const roleToggle = document.getElementById('roleToggle');

    const originalValues = {
      full_name: fullNameInput.value,
      email: emailInput.value,
      role: roleInput.value
    };

    let editing = false;

    function setEditing(isEditing) {
      editing = isEditing;
      fullNameInput.disabled = !isEditing;
      emailInput.disabled = !isEditing;

      roleToggle.style.display = isEditing ? 'inline-flex' : 'none';
      editButtons.style.display = isEditing ? 'flex' : 'none';
      editBtn.textContent = isEditing ? 'Editing…' : 'Edit';
    }

    function resetValues() {
      fullNameInput.value = originalValues.full_name;
      emailInput.value = originalValues.email;
      roleInput.value = originalValues.role;
      roleDisplay.textContent = originalValues.role;
      roleToggle.textContent = 'Switch to ' + (originalValues.role === 'Manager' ? 'User' : 'Manager');
    }

    // Toggle via Edit button
    editBtn.addEventListener('click', function () {
      if (!editing) {
        setEditing(true);
      } else {
        resetValues();
        setEditing(false);
      }
    });

    // Cancel button
    cancelBtn.addEventListener('click', function () {
      resetValues();
      setEditing(false);
    });

    // Role toggle
    roleToggle.addEventListener('click', function () {
      if (!editing) return;
      const newRole = roleInput.value === 'Manager' ? 'User' : 'Manager';
      roleInput.value = newRole;
      roleDisplay.textContent = newRole;
      roleToggle.textContent = 'Switch to ' + (newRole === 'Manager' ? 'User' : 'Manager');
    });
  })();

  function confirmDelete() {
    return window.confirm("Are you sure you want to delete this user? This action cannot be undone.");
  }
</script>

<%- include("../partials/footer") %>
