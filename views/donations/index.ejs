<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="bg-gradient-hero min-h-screen py-12 page-main">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- HEADER -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-foreground mb-4">Support Our Mission</h1>
      <p class="text-xl text-muted-foreground">Your donation makes a difference</p>
    </div>

    <!-- DONATION CTA CARD -->
    <div class="card-pastel text-center mb-12">

      <div class="w-16 h-16 mx-auto text-primary mb-6 text-5xl">
        💵
      </div>

      <h2 class="text-2xl font-bold text-foreground mb-4">Make a Donation</h2>
      <p class="text-muted-foreground mb-8">
        Help us empower young women through education
      </p>

      <a href="/donations/new" class="btn-pill btn-primary text-lg px-12">
        Donate Now
      </a>
    </div>

    <!-- DONATION LIST -->
    <div class="card-pastel">
      <h2 class="text-2xl font-bold text-foreground mb-6 flex items-center gap-2">
        <span class="inline-flex w-8 h-8 rounded-full bg-primary/10 items-center justify-center text-primary text-xl">📘</span>
        <span>
          <% if (currentUser.role === "Manager") { %>
            All Donations
          <% } else { %>
            Your Donations
          <% } %>
        </span>
      </h2>

      <% if (donations.length === 0) { %>
        <p class="text-muted-foreground text-center">No donations found.</p>
      <% } else { %>

        <div class="space-y-4">

          <% donations.forEach(d => { %>
            <div class="p-4 rounded-xl bg-white/70 shadow-sm flex justify-between items-center">

              <!-- LEFT SIDE -->
              <div>
                <p class="font-semibold text-foreground">
                  <% if (currentUser.role === "Manager") { %>
                    <%= d.donorname %>
                  <% } else { %>
                    Donation
                  <% } %>
                </p>

                <p class="text-sm text-muted-foreground mt-1">
                  <%= new Date(d.donationdate).toLocaleDateString() %>
                </p>
              </div>

              <!-- RIGHT SIDE -->
              <div class="text-right">
                <p class="text-xl font-bold text-primary">
                  $<%= Number(d.donationamount).toFixed(2) %>
                </p>

                <% if (currentUser.role === "Manager") { %>
                  <div class="mt-2 flex gap-3">
                    <a href="/donations/<%= d.donationid %>/edit" class="text-secondary font-medium text-sm">Edit</a>

                    <form action="/donations/<%= d.donationid %>?_method=DELETE" method="POST">
                      <button class="text-red-500 font-medium text-sm hover:underline">
                        Delete
                      </button>
                    </form>
                  </div>
                <% } %>
              </div>

            </div>
          <% }) %>

        </div>

      <% } %>

    </div>

  </div>
</main>

<%- include("../partials/footer") %>
