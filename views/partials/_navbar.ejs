<nav class="navbar-fixed">
  <div class="navbar-inner">
    <div class="navbar-main">
      <!-- Logo -->
      <a href="/" class="navbar-logo-link">
        <img 
          src="/images/Ella Rises Logo.avif" 
          alt="Ella Rises Logo" 
          class="navbar-logo-img"
        />
      </a>

      <!-- Desktop navigation -->
      <div class="navbar-links">
        <!-- Always shown with high contrast -->
        <a href="/" class="nav-link nav-link-primary">Home</a>
        <a href="/impact" class="nav-link nav-link-primary">Impact</a>

        <% if (currentUser) { %>
          <!-- Logged in: show all admin/dashboard links -->
          <a href="/participants" class="nav-link">Participants</a>
          <a href="/milestones" class="nav-link">Milestones</a>
          <a href="/events" class="nav-link">Events</a>
          <a href="/surveys" class="nav-link">Surveys</a>
          <a href="/donations" class="nav-link">Donations</a>
          <a href="/dashboard" class="nav-link nav-link-primary">Dashboard</a>

          <!-- User greeting -->
          <span class="nav-user-label">
            Hi, <%= currentUser.full_name %>
          </span>

          <!-- Logout -->
          <form action="/logout" method="POST" class="nav-logout-form">
            <button type="submit" class="btn-pill btn-secondary">Logout</button>
          </form>
        <% } else { %>
          <!-- Not logged in: only show Login -->
          <a href="/login" class="btn-pill btn-primary">Login</a>
        <% } %>
      </div>

      <!-- Mobile menu button -->
      <button
        class="navbar-menu-button"
        type="button"
        onclick="document.documentElement.classList.toggle('nav-open')"
      >
        <span class="navbar-menu-icon"></span>
      </button>
    </div>

    <!-- Mobile navigation -->
    <div class="navbar-mobile">
      <!-- Always shown with high contrast -->
      <a href="/" class="nav-link-mobile nav-link-primary">Home</a>
      <a href="/impact" class="nav-link-mobile nav-link-primary">Impact</a>

      <% if (currentUser) { %>
        <!-- Logged in: show all admin/dashboard links -->
        <a href="/participants" class="nav-link-mobile">Participants</a>
        <a href="/milestones" class="nav-link-mobile">Milestones</a>
        <a href="/events" class="nav-link-mobile">Events</a>
        <a href="/surveys" class="nav-link-mobile">Surveys</a>
        <a href="/donations" class="nav-link-mobile">Donations</a>
        <a href="/dashboard" class="nav-link-mobile nav-link-primary">Dashboard</a>

        <!-- User greeting -->
        <span class="nav-link-mobile nav-user-label">
          Hi, <%= currentUser.full_name %>
        </span>

        <!-- Logout -->
        <form action="/logout" method="POST" class="nav-mobile-logout-form">
          <button type="submit" class="nav-link-mobile btn-logout-mobile">Logout</button>
        </form>
      <% } else { %>
        <!-- Not logged in: only show Login -->
        <a href="/login" class="nav-link-mobile nav-link-primary">Login</a>
      <% } %>
    </div>
  </div>
</nav>
