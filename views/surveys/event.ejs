<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card" style="max-width: 900px; width:100%; position:relative;">
    <!-- Back button -->
    <a
      href="/surveys"
      class="btn-pill btn-secondary"
      style="
        position:absolute;
        top:1.2rem;
        left:1.6rem;
        padding:0.3rem 0.9rem;
        font-size:0.8rem;
      "
    >
      ← Back
    </a>

    <div style="text-align:center;">
      <h1 class="register-title">
        <%= event.eventname %>
      </h1>
      <p class="register-subtitle">Participant surveys for this event</p>
    </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <!-- Search -->
    <div style="margin-bottom:1rem; position:relative;">
      <div class="register-field" style="margin-bottom:0;">
        <label>Search surveys</label>
        <input
          type="text"
          id="surveySearch"
          placeholder="Search by participant name…"
          style="padding-right:2rem;"
        />
        <button
          type="button"
          id="clearSurveySearch"
          aria-label="Clear search"
          style="
            position:absolute;
            right:0.5rem;
            top:50%;
            transform:translateY(10%);
            border:none;
            background:transparent;
            font-size:1.1rem;
            line-height:1;
            cursor:pointer;
            color:#9CA3AF;
            transition:color 0.15s ease, transform 0.15s ease;
          "
          onmouseover="this.style.color='#ff8a80'; this.style.transform='translateY(10%) scale(1.25)';"
          onmouseout="this.style.color='#9CA3AF'; this.style.transform='translateY(10%) scale(1)';"
        >
          &times;
        </button>
      </div>
    </div>

    <!-- Table -->
    <div style="overflow-x:auto;">
      <table class="table table-striped" id="surveysTable" style="width:100%; border-collapse:collapse;">
        <thead>
          <tr>
            <th style="text-align:left; padding:0.6rem;">Participant</th>
            <th style="text-align:center; padding:0.6rem;">Overall Score</th>
            <th style="text-align:left; padding:0.6rem;">Comments</th>
            <th style="text-align:left; padding:0.6rem;">Submission Date</th>
          </tr>
        </thead>
        <tbody>
          <% surveys.forEach(s => { %>
            <tr>
              <td style="padding:0.6rem;">
                <a
                  href="/surveys/<%= s.surveyid %>"
                  class="register-link"
                  style="color:#ffc2b5; transition:transform 0.15s ease; display:inline-block;"
                  onmouseover="this.style.transform='translateY(-1px)';"
                  onmouseout="this.style.transform='translateY(0)';"
                >
                  <%= s.participantfirstname %> <%= s.participantlastname %>
                </a>
              </td>
              <td style="padding:0.6rem; text-align:center;">
                <%= s.surveyoverallscore %>
              </td>
              <td style="padding:0.6rem; max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                <%= s.surveycomments || '-' %>
              </td>
              <td style="padding:0.6rem;">
                <% if (s.surveysubmissiondate) { %>
                  <%= s.surveysubmissiondate.toISOString().slice(0,10) %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <p class="register-bottom" style="margin-top:1.2rem;">
      Total surveys: <strong><%= surveys.length %></strong>
    </p>
  </div>
</main>

<script>
  (function () {
    const input = document.getElementById('surveySearch');
    const clearBtn = document.getElementById('clearSurveySearch');
    const table = document.getElementById('surveysTable');
    if (!input || !table || !clearBtn) return;

    function filterRows() {
      const query = input.value.toLowerCase();
      const rows = table.querySelectorAll('tbody tr');
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
      });
    }

    input.addEventListener('input', filterRows);
    clearBtn.addEventListener('click', function () {
      input.value = '';
      filterRows();
      input.focus();
    });
  })();
</script>

<%- include("../partials/footer") %>
