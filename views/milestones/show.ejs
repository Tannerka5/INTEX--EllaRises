<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card" style="max-width: 720px; width:100%; position:relative;">

    <!-- Back button (top-left) -->
    <a
      href="/milestones"
      class="btn-pill btn-secondary"
      style="
        position:absolute;
        top:1.6rem;
        left:1.6rem;
        padding-inline:1.4rem;
        font-size:0.9rem;
      "
    >
      ← Go Back
    </a>

    <% if (currentUser && currentUser.role === 'Manager') { %>
      <button
        type="button"
        id="editToggle"
        class="btn-pill btn-secondary"
        style="position:absolute; top:1.6rem; right:1.6rem; padding-inline:1.4rem; font-size:0.9rem;"
      >
        Edit
      </button>
    <% } %>

    <div style="text-align:center;">
      <h1 class="register-title">
        <%= milestone.milestonetitle %>
      </h1>
      <p class="register-subtitle">Milestone details</p>
    </div>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form
      id="milestoneForm"
      action="/milestones/<%= milestone.milestoneid %>?_method=PUT"
      method="POST"
      class="register-form"
      style="margin-top:1.4rem;"
    >
      <div class="register-field">
        <label>Milestone Title</label>
        <input
          type="text"
          name="milestonetitle"
          value="<%= milestone.milestonetitle %>"
          disabled
        />
      </div>

      <div class="register-field">
  <label>Participant</label>

  <!-- Display-only text input -->
  <input
    type="text"
    id="participantDisplay"
    value="<%= milestone.participantfirstname %> <%= milestone.participantlastname %>"
    disabled
    style="width:100%;"
  />

  <!-- Small inline button that only shows in edit mode -->
  <% if (currentUser && currentUser.role === 'Manager') { %>
    <button
      type="button"
      id="participantOpenBtn"
      class="btn-pill btn-secondary"
      style="
        margin-top:0.5rem;
        padding:0.35rem 0.9rem;
        font-size:0.8rem;
        display:none;
      "
    >
      Change participant
    </button>
  <% } %>

  <!-- Dropdown container -->
  <div
    id="participantSelectWrapper"
    style="
      display:none;
      margin-top:0.5rem;
      padding:0.75rem;
      border-radius:0.8rem;
      background:#ffffff;
      border:1px solid rgba(0,0,0,0.08);
      box-shadow:0 10px 25px rgba(15,23,42,0.08);
    "
  >
    <input
      type="text"
      id="participantSearch"
      placeholder="Search participant…"
      style="width:100%; margin-bottom:0.5rem; padding:0.55rem 0.8rem; border-radius:0.6rem; border:1px solid rgba(0,0,0,0.12);"
    />
    <select
      name="participantid"
      id="participantSelect"
      size="6"
      style="width:100%; border-radius:0.6rem; padding:0.4rem;"
    >
      <% participants.forEach(p => { %>
        <option
          value="<%= p.participantid %>"
          <% if (p.participantid === milestone.participantid) { %>selected<% } %>
        >
          <%= p.participantfirstname %> <%= p.participantlastname %> —
          <%= p.participantdob ? p.participantdob.toISOString().slice(0,10) : '' %>
        </option>
      <% }) %>
    </select>
  </div>
</div>

      <div class="register-field">
        <label>Milestone Date</label>
        <input
          type="date"
          name="milestonedate"
          value="<%= milestone.milestonedate ? milestone.milestonedate.toISOString().slice(0,10) : '' %>"
          disabled
        />
      </div>

      <% if (currentUser && currentUser.role === 'Manager') { %>
        <div id="editButtons" style="display:none; margin-top:1.4rem; gap:0.8rem; flex-wrap:wrap;">
          <button
            type="submit"
            class="btn-pill btn-primary"
            style="background-color:#ffc2b5; border:none;"
          >
            Save Changes
          </button>
          <button type="button" id="cancelEdit" class="btn-pill btn-secondary">
            Cancel
          </button>
        </div>
      <% } %>
    </form>

    <% if (currentUser && currentUser.role === 'Manager') { %>
      <form
        id="deleteForm"
        action="/milestones/<%= milestone.milestoneid %>?_method=DELETE"
        method="POST"
        style="margin-top:1.8rem; text-align:right;"
        onsubmit="return confirmDelete();"
      >
        <button
          type="submit"
          class="btn-pill"
          style="background-color:#dc2626; color:white; border:none;"
        >
          Delete Milestone
        </button>
      </form>
    <% } %>
  </div>
</main>

<script>
  (function () {
    const editBtn = document.getElementById('editToggle');
    const form = document.getElementById('milestoneForm');
    const editButtons = document.getElementById('editButtons');
    const cancelBtn = document.getElementById('cancelEdit');
    if (!editBtn || !form || !editButtons || !cancelBtn) return;

    const titleInput = form.querySelector('input[name="milestonetitle"]');
    const dateInput  = form.querySelector('input[name="milestonedate"]');

    const participantDisplay = document.getElementById('participantDisplay');
    const participantWrapper = document.getElementById('participantSelectWrapper');
    const participantSelect  = document.getElementById('participantSelect');
    const participantSearch  = document.getElementById('participantSearch');
    const participantOpenBtn = document.getElementById('participantOpenBtn');

    const originalValues = {
      milestonetitle: titleInput.value,
      milestonedate : dateInput.value,
      participantid : participantSelect ? participantSelect.value : null
    };

    let editing = false;

    function setEditing(isEditing) {
      editing = isEditing;
      titleInput.disabled = !isEditing;
      dateInput.disabled  = !isEditing;

      if (!isEditing && participantWrapper) {
        participantWrapper.style.display = 'none';
      }

      if (participantOpenBtn) {
        participantOpenBtn.style.display = isEditing ? 'inline-flex' : 'none';
      }

      editButtons.style.display = isEditing ? 'flex' : 'none';
      editBtn.textContent = isEditing ? 'Editing…' : 'Edit';
    }

    function resetValues() {
      titleInput.value = originalValues.milestonetitle;
      dateInput.value  = originalValues.milestonedate;
      if (participantSelect && originalValues.participantid !== null) {
        participantSelect.value = originalValues.participantid;
        const opt = participantSelect.selectedOptions[0];
        if (opt) {
          participantDisplay.value = opt.text.split(' — ')[0];
        }
      }
      if (participantWrapper) participantWrapper.style.display = 'none';
    }

    // Toggle via Edit button
    editBtn.addEventListener('click', function () {
      if (!editing) {
        setEditing(true);
      } else {
        resetValues();
        setEditing(false);
      }
    });

    // Cancel button
    cancelBtn.addEventListener('click', function () {
      resetValues();
      setEditing(false);
    });

    // Show/hide dropdown when in edit mode
    if (participantOpenBtn && participantWrapper) {
      participantOpenBtn.addEventListener('click', () => {
        if (!editing) return;
        participantWrapper.style.display =
          participantWrapper.style.display === 'none' ? 'block' : 'none';
      });
    }

    // Search within dropdown
    if (participantSearch && participantSelect) {
      participantSearch.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        Array.from(participantSelect.options).forEach(opt => {
          opt.style.display = opt.text.toLowerCase().includes(q) ? '' : 'none';
        });
      });
    }

    // Initialize participantDisplay from current selection
    if (participantSelect && participantDisplay && participantSelect.selectedOptions[0]) {
      participantDisplay.value = participantSelect.selectedOptions[0].text.split(' — ')[0];
    }
  })();

  function confirmDelete() {
    return window.confirm("Are you sure you want to delete this milestone? This action cannot be undone.");
  }
</script>



<%- include("../partials/footer") %>
