<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="min-h-screen page-main bg-gradient-hero flex items-center py-20">
  <div class="max-w-md w-full mx-auto px-4 sm:px-6 lg:px-8">
    <div class="card-pastel animate-fade-in">

      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-foreground mb-2">Create Account</h1>
        <p class="text-muted-foreground">Join our community</p>
      </div>

      <form action="/register" method="POST" class="space-y-6">

        <!-- Full Name -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-2">Full Name</label>
          <div class="relative">
            <span class="input-icon">👤</span>
            <input 
              type="text"
              name="name"
              placeholder="Jane Doe"
              required
              class="input-pastel input-with-icon"
            />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-2">Email Address</label>
          <div class="relative">
            <span class="input-icon">📧</span>
            <input 
              type="email"
              name="email"
              placeholder="you@example.com"
              required
              class="input-pastel input-with-icon"
            />
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-2">Password</label>
          <div class="relative">
            <span class="input-icon">🔒</span>
            <input 
              type="password"
              name="password"
              placeholder="••••••••"
              required
              class="input-pastel input-with-icon"
            />
          </div>
        </div>

        <!-- Confirm Password -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-2">Confirm Password</label>
          <div class="relative">
            <span class="input-icon">🔒</span>
            <input 
              type="password"
              name="confirmPassword"
              placeholder="••••••••"
              required
              class="input-pastel input-with-icon"
            />
          </div>
        </div>

        <button type="submit" class="w-full btn-pill btn-primary">
          Create Account
        </button>

      </form>

      <div class="mt-6 text-center">
        <p class="text-muted-foreground">
          Already have an account?
          <a href="/login" class="text-primary font-semibold hover:underline">Sign in</a>
        </p>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>