<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="dashboard-main bg-gradient-hero">
  <div class="dashboard-container">

    <!-- Welcome -->
    <header>
      <h1 class="page-title">
        Welcome back, <%= currentUser.full_name %>!
      </h1>
      <p class="text-muted-foreground">
        See your upcoming events, surveys to complete, milestones, and donations.
      </p>
    </header>

    <!-- Primary row: one card per main area (clickable) -->
    <section class="dashboard-grid">
      <!-- Events -->
      <a href="/events" class="dashboard-card dashboard-card-link">
        <h2>Your Events</h2>
        <p class="stat-number"><%= upcomingEvents.length %></p>
        <p class="text-muted-foreground">Upcoming events you are registered for</p>
      </a>

      <!-- Surveys -->
      <a href="/surveys" class="dashboard-card dashboard-card-link">
        <h2>Your Surveys</h2>
        <p class="stat-number"><%= postSurveyEvents.length %></p>
        <p class="text-muted-foreground">Events waiting for your feedback</p>
      </a>

      <!-- Milestones -->
      <a href="/milestones" class="dashboard-card dashboard-card-link">
        <h2>Your Milestones</h2>
        <p class="stat-number"><%= milestones.length %></p>
        <p class="text-muted-foreground">Total milestones you have earned</p>
      </a>

      <!-- Donations -->
      <a href="/donations" class="dashboard-card dashboard-card-link">
        <h2>Your Donations</h2>
        <p class="stat-number">
          $<%= (userDonationTotal || 0).toFixed(2) %>
        </p>
        <p class="text-muted-foreground">Total amount you have donated</p>
      </a>

    </section>

    <!-- Secondary detail lists -->
    <section class="dashboard-grid">
      <!-- Upcoming events -->
      <article class="dashboard-card">
        <h2>Upcoming Events</h2>
        <% if (!upcomingEvents || upcomingEvents.length === 0) { %>
          <p class="text-muted-foreground">You are not registered for any upcoming events.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% upcomingEvents.forEach(e => { %>
              <li>
                <strong><%= e.eventname %></strong>
                <span class="text-muted-foreground">
                  <%= new Date(e.eventdatetimestart).toLocaleString() %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Surveys to complete -->
      <article class="dashboard-card">
        <h2>Surveys to Complete</h2>
        <% if (!postSurveyEvents || postSurveyEvents.length === 0) { %>
          <p class="text-muted-foreground">No surveys are waiting for you right now.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% postSurveyEvents.forEach(ev => { %>
              <li>
                <strong><%= ev.eventname %></strong>
                <span class="text-muted-foreground">
                  Help Ella Rises improve by sharing your experience.
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Your milestones -->
      <article class="dashboard-card">
        <h2>Your Milestones</h2>
        <% if (!milestones || milestones.length === 0) { %>
          <p class="text-muted-foreground">
            No milestones earned yet. Keep going—you’re just getting started.
          </p>
        <% } else { %>
          <ul class="dashboard-list">
            <% milestones.forEach(m => { %>
              <li>
                <strong><%= m.milestonetitle %></strong>
                <span class="text-muted-foreground">
                  <%= m.milestonedate ? new Date(m.milestonedate).toLocaleDateString() : "" %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Your donations -->
      <article class="dashboard-card">
        <h2>Your Donations</h2>
        <p class="stat-number">
          $<%= (userDonationTotal || 0).toFixed(2) %>
        </p>
        <p class="text-muted-foreground">
          Total amount you have donated through Ella Rises.
        </p>
      </article>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
