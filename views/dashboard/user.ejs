<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="bg-gradient-hero min-h-screen py-12 dashboard-main dashboard-container">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Welcome Section -->
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-foreground mb-2">
        Welcome back, <%= currentUser.full_name %>!
      </h1>
      <p class="text-muted-foreground">Track your activities and stay involved</p>
    </div>

    <div class="dashboard-grid">

        <!-- Participants -->
        <div class="dashboard-card">
          <h2>👥 Participants</h2>
          <a href="/participants" class="dashboard-section-link">View all →</a>

          <% if (participants.length === 0) { %>
            <p>No participants to display.</p>
          <% } else { %>
            <% participants.forEach(p => { %>
              <p><%= p.participantfirstname %> <%= p.participantlastname %></p>
            <% }) %>
          <% } %>
        </div>

        <!-- Upcoming Events -->
        <div class="dashboard-card">
          <h2>📅 Upcoming Events</h2>
          <a href="/events" class="dashboard-section-link">View all →</a>

          <% if (upcomingEvents.length === 0) { %>
            <p>No upcoming events.</p>
          <% } else { %>
            <% upcomingEvents.forEach(e => { %>
              <p><strong><%= e.eventname %></strong><br>
              <%= new Date(e.eventdatetimestart).toLocaleDateString() %></p>
            <% }) %>
          <% } %>
        </div>

        <!-- Post Surveys -->
        <div class="dashboard-card">
          <h2>📝 Post Surveys</h2>
          <a href="/surveys/post" class="dashboard-section-link">View all →</a>

          <% if (postSurveyEvents.length === 0) { %>
            <p>No surveys pending.</p>
          <% } else { %>
            <% postSurveyEvents.forEach(ev => { %>
              <p><%= ev.eventname %></p>
            <% }) %>
          <% } %>
        </div>

        <!-- Milestones -->
        <div class="dashboard-card">
          <h2>🏅 Milestones</h2>
          <a href="/milestones" class="dashboard-section-link">View all →</a>

          <% if (milestones.length === 0) { %>
            <p>No milestones earned yet.</p>
          <% } else { %>
            <% milestones.forEach(m => { %>
              <p><strong><%= m.milestonetitle %></strong></p>
            <% }) %>
          <% } %>
        </div>

        <!-- Donations -->
        <div class="dashboard-card">
          <h2>💖 Donations</h2>
          <a href="/donations" class="dashboard-section-link">View all →</a>

          <% if (donations.length === 0) { %>
            <p>No recent donations.</p>
          <% } else { %>
            <% donations.forEach(d => { %>
              <p>$<%= d.donationamount %> — <%= d.donorname %></p>
            <% }) %>
          <% } %>
        </div>

      </div>

    </div>
  </div>
</main>

<%- include("../partials/footer") %>
