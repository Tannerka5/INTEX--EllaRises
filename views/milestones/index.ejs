<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="bg-gradient-hero min-h-screen py-12 page-main">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <%- include("../partials/_flash") %>

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-10">
      <h1 class="text-4xl font-bold text-foreground">Milestones</h1>

      <% if (currentUser && currentUser.role === "Manager") { %>
        <a href="/milestones/new" class="btn-pill btn-primary px-6">
          Add Milestone
        </a>
      <% } %>
    </div>

    <!-- Milestones List -->
    <div class="card-pastel p-6">

      <% if (milestones.length === 0) { %>
        <p class="text-muted-foreground text-center py-6">
          No milestones found.
        </p>
      <% } else { %>

        <table class="w-full text-left">
          <thead>
            <tr class="text-muted-foreground border-b">
              <th class="pb-3">Milestone</th>
              <th class="pb-3">Completed On</th>
              <th class="pb-3">Participant</th>

              <% if (currentUser && currentUser.role === "Manager") { %>
                <th class="pb-3">Actions</th>
              <% } %>
            </tr>
          </thead>

          <tbody>
            <% milestones.forEach(m => { %>
              <tr class="border-b bg-white/60">
                
                <!-- Title -->
                <td class="py-4 font-semibold text-foreground">
                  <%= m.milestonetitle %>
                </td>

                <!-- Date -->
                <td class="py-4 text-muted-foreground">
                  <% if (m.milestonedate) { %>
                    <%= new Date(m.milestonedate).toLocaleDateString() %>
                  <% } else { %>
                    Not completed
                  <% } %>
                </td>

                <!-- Participant -->
                <td class="py-4 text-foreground">
                  <% if (m.participantfirstname) { %>
                    <%= m.participantfirstname %> <%= m.participantlastname %>
                  <% } else { %>
                    Unknown
                  <% } %>
                </td>

                <!-- Manager Actions -->
                <% if (currentUser && currentUser.role === "Manager") { %>
                  <td class="py-4">
                    <div class="flex gap-3 items-center">

                      <a 
                        href="/milestones/<%= m.milestoneid %>/edit" 
                        class="text-secondary hover:underline text-sm font-medium">
                        Edit
                      </a>

                      <form 
                        action="/milestones/<%= m.milestoneid %>?_method=DELETE" 
                        method="POST">
                        <button 
                          type="submit"
                          class="text-red-500 hover:underline text-sm font-medium">
                          Delete
                        </button>
                      </form>

                    </div>
                  </td>
                <% } %>

              </tr>
            <% }) %>
          </tbody>

        </table>

      <% } %>

    </div>

  </div>
</main>

<%- include("../partials/footer") %>
