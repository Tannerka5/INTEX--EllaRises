<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card">
    <h1 class="register-title">Add Survey</h1>
    <p class="register-subtitle">Enter survey results for an event.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/surveys" method="POST" class="register-form">
      <div class="register-field">
        <label>Participant</label>
        <select name="participantid" required>
          <option value="">Select participant...</option>
          <% participants.forEach(p => { %>
            <option value="<%= p.participantid %>">
              <%= p.participantlastname %>, <%= p.participantfirstname %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="register-field">
        <label>Event</label>
        <select name="eventoccurrenceid" required>
          <option value="">Select event...</option>
          <% events.forEach(e => { %>
            <option value="<%= e.eventoccurrenceid %>">
              <%= e.eventname %> – <%= new Date(e.eventdatetimestart).toLocaleString() %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="register-field">
        <label>Satisfaction Score</label>
        <input type="number" name="surveysatisfactionscore" min="1" max="10" />
      </div>

      <div class="register-field">
        <label>Usefulness Score</label>
        <input type="number" name="surveyusefulnessscore" min="1" max="10" />
      </div>

      <div class="register-field">
        <label>Instructor Score</label>
        <input type="number" name="surveyinstructorscore" min="1" max="10" />
      </div>

      <div class="register-field">
        <label>Recommendation Score</label>
        <input type="number" name="surveyrecommendationscore" min="1" max="10" />
      </div>

      <div class="register-field">
        <label>Overall Score</label>
        <input type="number" name="surveyoverallscore" min="1" max="10" />
      </div>

      <div class="register-field">
        <label>NPS Bucket</label>
        <input type="text" name="surveynpsbucket" placeholder="Promoter / Passive / Detractor" />
      </div>

      <div class="register-field">
        <label>Comments</label>
        <textarea name="surveycomments" rows="3" style="width:100%; padding:0.65rem 0.9rem; border-radius:0.6rem; border:1px solid rgba(0,0,0,0.15); font-size:0.95rem;"></textarea>
      </div>

      <button type="submit" class="btn-pill btn-primary register-btn">
        Save Survey
      </button>
    </form>

    <p class="register-bottom">
      <a href="/surveys" class="register-link">Back to Surveys</a>
    </p>
  </div>
</main>

<%- include("../partials/footer") %>
