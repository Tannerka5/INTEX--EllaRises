<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="main-container">
  <%- include("../partials/_flash") %>
  <div class="card" style="max-width:480px; margin:0 auto;">
    <div class="card-header">Record a donation</div>
    <p style="font-size:0.85rem; margin-bottom:0.7rem;">
      This internal form lets managers track donations inside the INTEX system. Public donors give through
      GiveButter on the main site.
    </p>
    <form action="/donations" method="POST">
      <div class="form-group">
        <label>Donor name</label>
        <input class="form-control" name="donor_name" required />
      </div>
      <div class="form-group">
        <label>Email</label>
        <input class="form-control" name="donor_email" type="email" />
      </div>
      <div class="form-group">
        <label>Amount (USD)</label>
        <input class="form-control" name="amount" type="number" step="0.01" min="0" />
      </div>
      <div class="form-group">
        <label>Notes</label>
        <textarea class="form-control" name="notes" rows="3"></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Save</button>
    </form>
  </div>
</main>

<%- include("../partials/footer") %>
