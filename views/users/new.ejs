<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card" style="max-width:600px;">

    <h1 class="register-title">Add New User</h1>
    <p class="register-subtitle">Create a new login for the Ella Rises system.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/users/new" method="POST">

      <div class="register-field">
        <label>Full Name</label>
        <input type="text" name="full_name" required />
      </div>

      <div class="register-field">
        <label>Email</label>
        <input type="email" name="email" required />
      </div>

      <div class="register-field">
        <label>Password</label>
        <input type="password" name="password" required />
      </div>

      <% if (superManager) { %>
        <div class="register-field">
          <label>Role</label>
          <select name="role">
            <option value="User">User</option>
            <option value="Manager">Manager</option>
          </select>
        </div>
      <% } %>

      <button type="submit" class="btn-pill btn-primary register-btn" style="width:100%; margin-top:1rem;">
        Create User
      </button>

    </form>

  </div>
</main>

<%- include("../partials/footer") %>
