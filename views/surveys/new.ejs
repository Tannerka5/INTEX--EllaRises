<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="main-container">
  <%- include("../partials/_flash") %>
  <div class="card">
    <div class="card-header">New survey</div>
    <form action="/surveys" method="POST">
      <div class="form-group">
        <label>Participant</label>
        <select class="form-control" name="participant_id" required>
          <option value="">Select participant</option>
          <% participants.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.first_name %> <%= p.last_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Event</label>
        <select class="form-control" name="event_id" required>
          <option value="">Select event</option>
          <% events.forEach(e => { %>
            <option value="<%= e.id %>"><%= e.name %> (<%= e.event_date %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Satisfaction (1–5)</label>
        <input class="form-control" type="number" name="satisfaction" min="1" max="5" required />
      </div>
      <div class="form-group">
        <label>Usefulness (1–5)</label>
        <input class="form-control" type="number" name="usefulness" min="1" max="5" required />
      </div>
      <div class="form-group">
        <label>Recommendation score (1–10)</label>
        <input class="form-control" type="number" name="recommendation_score" min="1" max="10" required />
      </div>
      <div class="form-group">
        <label>Comments</label>
        <textarea class="form-control" name="comments" rows="3"></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Submit survey</button>
    </form>
  </div>
</main>

<%- include("../partials/footer") %>
