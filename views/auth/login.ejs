<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card">
    <h1 class="register-title">Welcome Back</h1>
    <p class="register-subtitle">Sign in to access your account!</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/login" method="POST" class="register-form">
      <!-- Email -->
      <div class="register-field">
        <label>Email</label>
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          required
        />
      </div>

      <!-- Password -->
      <div class="register-field">
        <label>Password</label>
        <input
          type="password"
          name="password"
          placeholder="••••••••"
          required
        />
      </div>

      <!-- Button -->
      <button type="submit" class="btn-pill btn-primary register-btn">
        Sign In
      </button>
    </form>

    <p class="register-bottom">
      Don't have an account?
      <a href="/register" class="register-link">Sign up</a>
    </p>
  </div>
</main>

<%- include("../partials/footer") %>
