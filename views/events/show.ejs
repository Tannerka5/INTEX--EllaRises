<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card" style="max-width: 900px; width:100%; position:relative;">

    <!-- Back button (top-left) -->
    <a
      href="/events"
      class="btn-pill btn-secondary"
      style="
        position:absolute;
        top:1.6rem;
        left:1.6rem;
        padding-inline:1.4rem;
        font-size:0.9rem;
      "
    >
      ← Go Back
    </a>

    <% if (currentUser && currentUser.role === 'Manager') { %>
      <button
        type="button"
        id="editToggle"
        class="btn-pill btn-secondary"
        style="position:absolute; top:1.6rem; right:1.6rem; padding-inline:1.4rem; font-size:0.9rem;"
      >
        Edit
      </button>
    <% } %>

    <div style="text-align:center;">
      <h1 class="register-title">
        <%= event.eventname %>
      </h1>
      <h2>Event details</h2>
    </div>

    <%
// Determine if user is already registered
let alreadyRegistered = false;

if (registrations && currentUser && currentUser.participantid) {
  alreadyRegistered = registrations.some(r => r.participantid == currentUser.participantid);
}
%>

<% if (currentUser && currentUser.role !== 'Manager') { %>

  <% if (alreadyRegistered) { %>
    <div class="alert alert-success" style="margin-top:1rem;">
      You are already registered for this event.
    </div>

  <% } else if (event.eventcapacity && registrations.length >= event.eventcapacity) { %>
    <div class="alert alert-danger" style="margin-top:1rem;">
      This event is full.
    </div>

  <% } else if (event.eventregistrationdeadline && new Date() > new Date(event.eventregistrationdeadline)) { %>
    <div class="alert alert-danger" style="margin-top:1rem;">
      Registration deadline has passed.
    </div>

  <% } else { %>
    <form action="/events/<%= event.eventoccurrenceid %>/register" method="POST" style="margin-top:1rem;">
      <button class="btn-pill btn-primary" style="padding-inline:1.4rem;">
        Sign Up for This Event
      </button>
    </form>
  <% } %>

<% } %>

    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form
      id="eventForm"
      action="/events/<%= event.eventoccurrenceid %>?_method=PUT"
      method="POST"
      class="register-form"
      style="margin-top:1.4rem;"
    >

      <div class="register-field">
  <label>Template Name</label>
  <input
    type="text"
    id="templateDisplay"
    value="<%= event.template_eventname %>"
    disabled
    style="width:100%;"
  />

  <% if (currentUser && currentUser.role === 'Manager') { %>
    <button
      type="button"
      id="templateOpenBtn"
      class="btn-pill btn-secondary"
      style="
        margin-top:0.5rem;
        padding:0.35rem 0.9rem;
        font-size:0.8rem;
        display:none;
      "
    >
      Change template
    </button>
  <% } %>

  <div
    id="templateSelectWrapper"
    style="
      display:none;
      margin-top:0.5rem;
      padding:0.75rem;
      border-radius:0.8rem;
      background:#ffffff;
      border:1px solid rgba(0,0,0,0.08);
      box-shadow:0 10px 25px rgba(15,23,42,0.08);
    "
  >
    <select
      name="eventtemplateid"
      id="templateSelect"
      size="6"
      style="width:100%; border-radius:0.6rem; padding:0.4rem;"
    >
      <% templates.forEach(t => { %>
        <option
          value="<%= t.eventtemplateid %>"
          <% if (t.eventtemplateid === event.eventtemplateid) { %>selected<% } %>
        >
          <%= t.eventname %> (<%= t.eventtype %>)
        </option>
      <% }) %>
    </select>
  </div>
</div>



      <div class="register-field">
        <label>Start Date & Time</label>
        <input
          type="datetime-local"
          name="eventdatetimestart"
          <%
          function offsetLocal(dt) {
            if (!dt) return '';
            const d = new Date(dt);
            d.setHours(d.getHours() - 7); // adjust UTC -> MST
            return d.toISOString().slice(0,16);
          }
          %>
          ...
        value="<%= offsetLocal(event.eventdatetimestart) %>"
          disabled
        />
      </div>

      <div class="register-field">
        <label>End Date & Time</label>
        <input
          type="datetime-local"
          name="eventdatetimeend"
          <%
          function offsetLocal(dt) {
            if (!dt) return '';
            const d = new Date(dt);
            d.setHours(d.getHours() - 7); // adjust UTC -> MST
            return d.toISOString().slice(0,16);
          }
          %>
          ...
          value="<%= offsetLocal(event.eventdatetimeend) %>"
          disabled
        />
      </div>

      <div class="register-field">
        <label>Location</label>
        <input
          type="text"
          name="eventlocation"
          value="<%= event.eventlocation || '' %>"
          disabled
        />
      </div>

      <div class="register-field">
        <label>Capacity</label>
        <input
          type="number"
          name="eventcapacity"
          value="<%= event.eventcapacity || '' %>"
          disabled
        />
      </div>

      <div class="register-field">
        <label>Registration Deadline</label>
        <input
          type="datetime-local"
          name="eventregistrationdeadline"
          <%
          function offsetLocal(dt) {
            if (!dt) return '';
            const d = new Date(dt);
            d.setHours(d.getHours() - 7); // adjust UTC -> MST
            return d.toISOString().slice(0,16);
          }
          %>
          ...
          value="<%= offsetLocal(event.eventregistrationdeadline) %>"
          disabled
        />
      </div>

      <% if (currentUser && currentUser.role === 'Manager') { %>
        <div id="editButtons" style="display:none; margin-top:1.4rem; gap:0.8rem; flex-wrap:wrap;">
          <button
            type="submit"
            class="btn-pill btn-primary"
            style="background-color:#ffc2b5; border:none;"
          >
            Save Changes
          </button>
          <button type="button" id="cancelEdit" class="btn-pill btn-secondary">
            Cancel
          </button>
        </div>
      <% } %>
    </form>

    <% if (currentUser && currentUser.role === 'Manager') { %>
      <form
        id="deleteForm"
        action="/events/<%= event.eventoccurrenceid %>?_method=DELETE"
        method="POST"
        style="margin-top:1.8rem; text-align:right;"
        onsubmit="return confirmDelete();"
      >
        <button
          type="submit"
          class="btn-pill"
          style="background-color:#dc2626; color:white; border:none;"
        >
          Delete Event
        </button>
      </form>
    <% } %>
  </div>
</main>

<script>
  (function () {
    const editBtn = document.getElementById('editToggle');
    const form = document.getElementById('eventForm');
    const editButtons = document.getElementById('editButtons');
    const cancelBtn = document.getElementById('cancelEdit');
    if (!editBtn || !form || !editButtons || !cancelBtn) return;

    const inputs = form.querySelectorAll(
      'input[name="eventname"], ' +
      'input[name="eventdatetimestart"], ' +
      'input[name="eventdatetimeend"], ' +
      'input[name="eventlocation"], ' +
      'input[name="eventcapacity"], ' +
      'input[name="eventregistrationdeadline"]'
    );
    const templateDisplay = document.getElementById('templateDisplay');
    const templateWrapper = document.getElementById('templateSelectWrapper');
    const templateSelect = document.getElementById('templateSelect');
    const templateOpenBtn = document.getElementById('templateOpenBtn');

    const originalValues = {};
    inputs.forEach(input => { originalValues[input.name] = input.value; });
    originalValues.eventtemplateid = templateSelect ? templateSelect.value : null;

    let editing = false;

    function setEditing(isEditing) {
      editing = isEditing;
      inputs.forEach(input => { input.disabled = !isEditing; });

      if (!isEditing && templateWrapper) {
        templateWrapper.style.display = 'none';
      }

      if (!isEditing && templateSelect && templateDisplay) {
        const opt = templateSelect.selectedOptions[0];
        if (opt) templateDisplay.value = opt.text;
      }

      if (templateOpenBtn) {
        templateOpenBtn.style.display = isEditing ? 'inline-flex' : 'none';
      }

      editButtons.style.display = isEditing ? 'flex' : 'none';
      editBtn.textContent = isEditing ? 'Editing…' : 'Edit';
    }

    function resetValues() {
      inputs.forEach(input => {
        if (originalValues.hasOwnProperty(input.name)) {
          input.value = originalValues[input.name];
        }
      });
      if (templateSelect) templateSelect.value = originalValues.eventtemplateid;
      if (templateWrapper) templateWrapper.style.display = 'none';
      if (templateSelect && templateDisplay) {
        const opt = templateSelect.selectedOptions[0];
        if (opt) templateDisplay.value = opt.text;
      }
    }

    editBtn.addEventListener('click', function () {
      if (!editing) {
        setEditing(true);
      } else {
        resetValues();
        setEditing(false);
      }
    });

    cancelBtn.addEventListener('click', function () {
      resetValues();
      setEditing(false);
    });

    if (templateOpenBtn && templateWrapper) {
      templateOpenBtn.addEventListener('click', () => {
        if (!editing) return;
        templateWrapper.style.display =
          templateWrapper.style.display === 'none' ? 'block' : 'none';
      });
    }
  })();

  function confirmDelete() {
    return window.confirm("Are you sure you want to delete this event? This action cannot be undone.");
  }
</script>

<%- include("../partials/footer") %>
