<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<link rel="stylesheet" href="/css/surveys-index.css">

<main>
  <br><br><br><br><br><br><br>
  <div class="survey-index-card">
    <a href="/surveys/new" class="survey-view-btn">Add Survey</a>
    <h1 class="survey-index-title">Survey Summary</h1>
    <p class="survey-index-subtitle">Average ratings by event</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% 
      // Group events by event name
      const grouped = {};

      events.forEach(ev => {
        const name = ev.eventname;
        if (!grouped[name]) {
          grouped[name] = {
            eventname: name,
            avg_overall: [],
            rows: []
          };
        }
        grouped[name].avg_overall.push(Number(ev.avg_overall));
        grouped[name].rows.push(ev);
      });

      const summarized = Object.values(grouped).map(g => {
        const avg = g.avg_overall.reduce((a, b) => a + b, 0) / g.avg_overall.length;
        return {
          eventname: g.eventname,
          avg_overall: avg.toFixed(2),
          id: g.rows[0].eventtemplateid
        };
      });
    %>

    <div class="survey-index-table-container">
      <table class="survey-index-table">
        <thead>
          <tr>
            <th>Event</th>
            <th style="text-align:center;">Average Score</th>
            <th style="text-align:center;">View Surveys</th>
          </tr>
        </thead>

        <tbody>
          <% summarized.forEach(e => { %>
            <tr>
              <td><%= e.eventname %></td>

              <td class="avg-score-cell">
                <%= e.avg_overall %>
              </td>

              <td class="view-btn-cell">
                <a href="/surveys/event/<%= e.id %>" class="survey-view-btn">
                  View Surveys
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include("../partials/footer") %>