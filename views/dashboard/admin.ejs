<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="dashboard-main bg-gradient-hero">
  <div class="dashboard-container">

    <!-- Welcome -->
    <header>
      <h1 class="page-title">
        Welcome, <%= currentUser.full_name %>!
      </h1>
      <p class="text-muted-foreground">
        Quick overview of participants, events, surveys, milestones, and donations.
      </p>
    </header>

    <!-- Primary summary row: one card per main area -->
    <section class="dashboard-grid">
      <!-- Participants -->
      <a href="/participants" class="dashboard-card dashboard-card-link">
        <h2>Participants</h2>
        <p class="stat-number"><%= participantCount %></p>
        <p class="text-muted-foreground">Total registered participants</p>
      </a>

      <!-- Events -->
      <a href="/events" class="dashboard-card dashboard-card-link">
        <h2>Events</h2>
        <p class="stat-number"><%= eventCount %></p>
        <p class="text-muted-foreground">Total events scheduled</p>
      </a>

      <!-- Surveys -->
      <a href="/surveys" class="dashboard-card dashboard-card-link">
        <h2>Surveys</h2>
        <p class="stat-number"><%= surveyCount %></p>
        <p class="text-muted-foreground">Completed post‑event surveys</p>
      </a>

      <!-- Milestones -->
      <a href="/milestones" class="dashboard-card dashboard-card-link">
        <h2>Milestones</h2>
        <p class="stat-number">
          <%= typeof milestoneTotal !== "undefined" ? milestoneTotal : 0 %>
        </p>
        <p class="text-muted-foreground">Total milestones awarded</p>
      </a>

      <!-- Donations -->
      <a href="/donations" class="dashboard-card dashboard-card-link">
        <h2>Donations</h2>
        <p class="stat-number">
          $<%= donationTotal.toFixed(2) %>
        </p>
        <p class="text-muted-foreground">Total donation amount recorded</p>
      </a>

    </section>

    <!-- Detailed lists, ordered by importance -->
    <section class="dashboard-grid">
      <!-- Upcoming events (high priority for managers) -->
      <article class="dashboard-card">
        <h2>Upcoming Events</h2>
        <% if (!upcomingEvents || upcomingEvents.length === 0) { %>
          <p class="text-muted-foreground">No upcoming events scheduled.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% upcomingEvents.forEach(e => { %>
              <li>
                <strong><%= e.eventname %></strong>
                <span class="text-muted-foreground">
                  <%= new Date(e.eventdatetimestart).toLocaleString() %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Recent surveys -->
      <article class="dashboard-card">
        <h2>Recent Surveys</h2>
        <% if (!recentSurveys || recentSurveys.length === 0) { %>
          <p class="text-muted-foreground">No recent surveys.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% recentSurveys.forEach(s => { %>
              <li>
                <strong><%= s.eventname %></strong>
                <span class="text-muted-foreground">
                  By <%= s.participantfirstname %> <%= s.participantlastname %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Recent participants -->
      <article class="dashboard-card">
        <h2>Recent Participants</h2>
        <% if (!recentParticipants || recentParticipants.length === 0) { %>
          <p class="text-muted-foreground">No recent participants.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% recentParticipants.forEach(p => { %>
              <li>
                <strong><%= p.participantfirstname %> <%= p.participantlastname %></strong>
                <span class="text-muted-foreground">
                  <%= p.participantschooloremployer || "" %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Milestone leaders -->
      <article class="dashboard-card">
        <h2>Top Milestone Earners</h2>
        <% if (!milestoneLeaders || milestoneLeaders.length === 0) { %>
          <p class="text-muted-foreground">No milestones recorded yet.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% milestoneLeaders.forEach(m => { %>
              <li>
                <strong><%= m.participantfirstname %> <%= m.participantlastname %></strong>
                <span class="text-muted-foreground">
                  <%= m.total %> milestones
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>

      <!-- Recent donations -->
      <article class="dashboard-card">
        <h2>Recent Donations</h2>
        <% if (!donations || donations.length === 0) { %>
          <p class="text-muted-foreground">No recent donations.</p>
        <% } else { %>
          <ul class="dashboard-list">
            <% donations.forEach(d => { %>
              <li>
                <strong>$<%= Number(d.donationamount).toFixed(2) %></strong>
                <span class="text-muted-foreground">
                  By <%= d.donorname || "Anonymous" %>
                  <% if (d.donationdate) { %>
                    • <%= new Date(d.donationdate).toLocaleDateString() %>
                  <% } %>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
