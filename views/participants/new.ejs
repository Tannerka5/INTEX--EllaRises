<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card">
    <h1 class="register-title">Add Participant</h1>
    <p class="register-subtitle">Create a new participant record.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/participants" method="POST" class="register-form">
      <div class="register-field">
        <label>Email</label>
        <input type="email" name="participantemail" required />
      </div>

      <div class="register-field">
        <label>First Name</label>
        <input type="text" name="participantfirstname" required />
      </div>

      <div class="register-field">
        <label>Last Name</label>
        <input type="text" name="participantlastname" required />
      </div>

      <div class="register-field">
        <label>Date of Birth</label>
        <input type="date" name="participantdob" />
      </div>

      <div class="register-field">
        <label>Role</label>
        <input type="text" name="participantrole" placeholder="Student, Mentor, etc." />
      </div>

      <div class="register-field">
        <label>Phone</label>
        <input type="text" name="participantphone" />
      </div>

      <div class="register-field">
        <label>City</label>
        <input type="text" name="participantcity" />
      </div>

      <div class="register-field">
        <label>State</label>
        <input type="text" name="participantstate" />
      </div>

      <div class="register-field">
        <label>ZIP</label>
        <input type="text" name="participantzip" />
      </div>

      <div class="register-field">
        <label>School or Employer</label>
        <input type="text" name="participantschooloremployer" />
      </div>

      <div class="register-field">
        <label>Field of Interest</label>
        <input type="text" name="participantfieldofinterest" />
      </div>

      <button type="submit" class="btn-pill btn-primary register-btn">
        Save Participant
      </button>
    </form>

    <p class="register-bottom">
      <a href="/participants" class="register-link">Back to Participants</a>
    </p>
  </div>
</main>

<%- include("../partials/footer") %>
