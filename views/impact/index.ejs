<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="page-main">

  <!-- Hero Section -->
  <section class="bg-gradient-hero py-20">
    <div class="section-inner text-center max-w-3xl mx-auto animate-fade-in">
      <h1 class="text-5xl font-bold text-foreground mb-6">
        Our <span class="text-primary">Impact</span>
      </h1>
      <p class="text-xl text-muted-foreground">
        Transforming lives and building futures through education and empowerment
      </p>
    </div>
  </section>

  <!-- Impact Stats -->
  <section class="py-16 bg-white">
    <div class="section-inner grid md:grid-cols-3 gap-8">

      <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="text-5xl font-bold text-foreground mb-2">500+</div>
        <div class="text-lg text-muted-foreground mb-4">Young Women Served</div>
        <p class="text-sm text-muted-foreground">Across all programs since 2020</p>
      </div>

      <div class="stat-card">
        <div class="stat-icon">🏅</div>
        <div class="text-5xl font-bold text-foreground mb-2">50+</div>
        <div class="text-lg text-muted-foreground mb-4">Programs Completed</div>
        <p class="text-sm text-muted-foreground">STEAM, Arts, Culture, Mentorship</p>
      </div>

      <div class="stat-card">
        <div class="stat-icon">📈</div>
        <div class="text-5xl font-bold text-foreground mb-2">95%</div>
        <div class="text-lg text-muted-foreground mb-4">Success Rate</div>
        <p class="text-sm text-muted-foreground">Goal achievement across programs</p>
      </div>

    </div>
  </section>

  <!-- Program Success Stories -->
  <section class="py-20 bg-gradient-section curved-section">
    <div class="section-inner">
      <h2 class="text-4xl font-bold text-center mb-16 text-foreground">
        Program Success Stories
      </h2>

      <div class="grid md:grid-cols-2 gap-8">

        <!-- STEAM -->
        <div class="card-pastel">
          <div class="stat-icon-large">📘</div>
          <h3 class="text-2xl font-bold mb-3 text-foreground">STEAM Education</h3>
          <p class="text-muted-foreground mb-4">
            Our STEAM programs opened doors for 250+ participants
          </p>
          <ul class="impact-list">
            <li>85% increased interest in STEM careers</li>
            <li>40 participants won science fair awards</li>
            <li>15 received STEM scholarships</li>
          </ul>
        </div>

        <!-- Arts & Culture -->
        <div class="card-pastel">
          <div class="stat-icon-large">💖</div>
          <h3 class="text-2xl font-bold mb-3 text-foreground">Arts & Culture</h3>
          <p class="text-muted-foreground mb-4">
            Celebrating heritage and building identity
          </p>
          <ul class="impact-list">
            <li>100+ community performances</li>
            <li>90% increased cultural awareness</li>
            <li>30 continued arts education</li>
          </ul>
        </div>

        <!-- Mentorship -->
        <div class="card-pastel">
          <div class="stat-icon-large">🎯</div>
          <h3 class="text-2xl font-bold mb-3 text-foreground">Mentorship Program</h3>
          <p class="text-muted-foreground mb-4">
            Life-changing guidance and support
          </p>
          <ul class="impact-list">
            <li>150+ mentor-mentee pairs</li>
            <li>95% increased confidence</li>
            <li>80% met academic goals</li>
          </ul>
        </div>

        <!-- Scholarship -->
        <div class="card-pastel">
          <div class="stat-icon-large">🏆</div>
          <h3 class="text-2xl font-bold mb-3 text-foreground">Scholarship Program</h3>
          <p class="text-muted-foreground mb-4">
            Funding futures across the community
          </p>
          <ul class="impact-list">
            <li>$250k+ awarded</li>
            <li>75 students funded</li>
            <li>100% graduation rate</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 bg-white">
    <div class="section-inner">
      <h2 class="text-4xl font-bold text-center mb-16 text-foreground">
        What Our Participants Say
      </h2>

      <div class="grid md:grid-cols-3 gap-8">

        <div class="card-pastel">
          <div class="text-4xl mb-4">💖</div>
          <p class="text-muted-foreground italic mb-4">
            "Ella Rises changed my life. I discovered my passion for engineering!"
          </p>
          <p class="font-semibold text-foreground">- Maria, Age 17</p>
        </div>

        <div class="card-pastel">
          <div class="text-4xl mb-4">✨</div>
          <p class="text-muted-foreground italic mb-4">
            "My mentor gave me the confidence to apply for scholarships."
          </p>
          <p class="font-semibold text-foreground">- Sofia, Age 18</p>
        </div>

        <div class="card-pastel">
          <div class="text-4xl mb-4">🌟</div>
          <p class="text-muted-foreground italic mb-4">
            "I learned more about my culture through dance and music."
          </p>
          <p class="font-semibold text-foreground">- Isabella, Age 16</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-section">
    <div class="cta-inner text-center">
      <h2 class="cta-title">Help Us Create More Success Stories</h2>
      <p class="cta-subtitle">Your support empowers young women</p>

      <a href="/donations" class="btn-pill btn-primary text-lg px-12">
        Donate Today
      </a>
    </div>
  </section>

</main>

<%- include("../partials/footer") %>