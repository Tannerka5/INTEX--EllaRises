<%- include("../partials/header") %>
<%- include("../partials/_navbar") %>

<main class="register-page-wrapper">
  <div class="register-card">
    <h1 class="register-title">Add Event</h1>
    <p class="register-subtitle">Schedule a new Ella Rises event.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/events" method="POST" class="register-form">
      <!-- Event Name (NEW, first field) -->
      <div class="register-field">
        <label>Event Name</label>
        <input
          type="text"
          name="eventname"
          placeholder="STEM Workshop – Robotics"
          required
        />
      </div>

      <div class="register-field">
        <label>Event Template</label>
        <select name="eventtemplateid" required>
          <option value="">Select event type...</option>
          <% templates.forEach(t => { %>
            <option value="<%= t.eventtemplateid %>">
              <%= t.eventname %> (<%= t.eventtype %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="register-field">
        <label>Start Date & Time</label>
        <input type="datetime-local" name="eventdatetimestart" required />
      </div>

      <div class="register-field">
        <label>End Date & Time</label>
        <input type="datetime-local" name="eventdatetimeend" />
      </div>

      <div class="register-field">
        <label>Location</label>
        <input type="text" name="eventlocation" required />
      </div>

      <div class="register-field">
        <label>Capacity</label>
        <input type="number" name="eventcapacity" min="1" />
      </div>

      <div class="register-field">
        <label>Registration Deadline</label>
        <input type="datetime-local" name="eventregistrationdeadline" />
      </div>

      <button type="submit" class="btn-pill btn-primary register-btn">
        Save Event
      </button>
    </form>

    <p class="register-bottom">
      <a href="/events" class="register-link">Back to Events</a>
    </p>
  </div>
</main>

<%- include("../partials/footer") %>
